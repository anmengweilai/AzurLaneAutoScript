{
  "compilerOptions": {
    "target": "es2017",
    "lib": ["dom", "dom.iterable", "esnext"],
    "module": "esnext",
    "moduleResolution": "node",
    "jsx": "react-jsx",
    "strict": true,
    "esModuleInterop": true,
    "skipLibCheck": true,
    "resolveJsonModule": true,
    "noEmit": true,
    "baseUrl": ".",
    "paths": {
      "@/*": ["src/*"],
      "@/*": ["src/*"],
      "@@/*": ["src/.umi/*"],
      "@umijs/max": ["node_modules/umi"]
    }
  },
  "include": ["src", ".umirc.ts", "config"]
}
